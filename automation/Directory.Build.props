<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'KiCad.Automation.Model' Or '$(MSBuildProjectName)' == 'KiCad.Automation.Native' Or '$(MSBuildProjectName)' == 'KiCad.Automation.Mcp' Or '$(MSBuildProjectName)' == 'KiCad.Automation.Distribution'">
    <RuntimeIdentifiers>linux-x64;osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>
</Project>
